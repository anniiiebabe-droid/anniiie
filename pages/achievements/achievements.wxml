<view class="page"><view class="achievement-head"><text>成长的每一步，都值得被记住</text></view><view wx:for="{{items}}" wx:key="id" class="badge card {{item.unlocked?'':'locked'}}"><view class="icon">{{item.icon}}</view><view class="grow"><text class="name">{{item.name}}</text><text class="desc">{{item.desc}}</text></view><text class="status">{{item.unlocked?'已获得':'未解锁'}}</text></view></view>
