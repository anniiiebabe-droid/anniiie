.fridge-head{display:flex;align-items:center;justify-content:space-between;margin:5rpx 0 28rpx}.title{display:block;font-size:43rpx;font-weight:900}.subtitle{display:block;font-size:23rpx;color:#817d72;margin-top:8rpx}.mini-add{margin:0;padding:0 22rpx;height:70rpx;line-height:70rpx;background:#789176;color:#fff;border-radius:20rpx;font-size:25rpx}.mini-add::after{border:0}.filters{width:100%;white-space:nowrap;margin-bottom:20rpx}.filter-row{display:flex;gap:13rpx}.filter{display:inline-flex;padding:13rpx 23rpx;background:#eae6dc;border-radius:20rpx;color:#777168;font-size:24rpx}.filter.active{background:#789176;color:#fff}.notice{padding:18rpx 20rpx;margin-bottom:22rpx;border-radius:18rpx;background:#f2ead7;color:#7d6c53;font-size:21rpx;line-height:1.5}
