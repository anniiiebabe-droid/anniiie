.home{padding-top:calc(38rpx + env(safe-area-inset-top))}.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx}.eyebrow{display:block;color:#789176;font-size:20rpx;letter-spacing:4rpx;font-weight:700}.logo{font-size:48rpx;font-weight:900;letter-spacing:2rpx}.date-badge{flex:none;padding:14rpx 20rpx;border-radius:18rpx;background:#ebe5d5;color:#686257;font-size:24rpx}.hero{min-height:282rpx;padding:28rpx 18rpx 22rpx 30rpx;box-sizing:border-box;display:grid;grid-template-columns:minmax(0,1fr) 230rpx;align-items:center;overflow:hidden;background:linear-gradient(145deg,#fffdf8,#e5eddf)}.hero-copy{position:relative;z-index:2;min-width:0}.hello{display:block;font-size:21rpx;color:#70776b;line-height:1.5}.headline{display:block;font-size:41rpx;font-weight:900;line-height:1.16;margin:13rpx 0 10rpx}.hint{display:block;max-width:310rpx;font-size:21rpx;line-height:1.45;color:#827d72}.hero lingling-character{width:230rpx;align-self:end}.device-link{flex:none;font-size:23rpx;background:#e5e2d8;padding:11rpx 18rpx;border-radius:15rpx}.quick-add{min-height:120rpx;margin-top:22rpx;padding:18rpx 22rpx;display:grid;grid-template-columns:64rpx minmax(0,1fr) 30rpx;column-gap:18rpx;align-items:center;text-align:left;border-radius:27rpx;background:#6f876d;color:white}.quick-add::after{border:0}.plus{width:64rpx;height:64rpx;border-radius:20rpx;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:40rpx}.quick-title,.quick-sub{display:block}.quick-title{font-size:28rpx;font-weight:700;line-height:1.25}.quick-sub{font-size:19rpx;line-height:1.4;opacity:.8;margin-top:5rpx}.arrow{margin-left:auto;font-size:47rpx;color:#a39e93}.quick-add .arrow{color:white}.recipe{padding:24rpx;display:flex;align-items:center}.recipe-emoji{flex:none;width:105rpx;height:105rpx;border-radius:28rpx;background:#f5ead6;display:flex;align-items:center;justify-content:center;font-size:56rpx;margin-right:22rpx}.recipe-name{display:block;font-size:31rpx;font-weight:700}.recipe-meta,.missing,.ready{display:block;font-size:22rpx;color:#817d72;margin-top:8rpx}.missing{color:#ad7655}.ready{color:#668060}.growth{padding:28rpx}.growth-top{display:flex;justify-content:space-between;font-weight:700;margin-bottom:20rpx}.stars{color:#9e782c}.task{display:block;margin-top:20rpx;padding:17rpx;border-radius:18rpx;background:#f5f0e4;color:#777167;font-size:23rpx;line-height:1.45}
@media(max-width:350px){.hero{grid-template-columns:minmax(0,1fr) 190rpx}.headline{font-size:37rpx}.hint{font-size:19rpx}.hero lingling-character{width:190rpx}}
