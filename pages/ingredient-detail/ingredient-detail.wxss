.detail-hero{padding:35rpx;text-align:center}.big-icon{margin:0 auto 18rpx;width:130rpx;height:130rpx;border-radius:42rpx;background:#dfe9dc;display:flex;align-items:center;justify-content:center;font-size:56rpx;font-weight:800}.name{display:block;font-size:43rpx;font-weight:900;margin-bottom:12rpx}.quantity{display:block;margin-top:22rpx;font-size:26rpx}.quantity b{font-size:37rpx}.status{display:block;color:#817d72;font-size:22rpx;margin-top:8rpx}.actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.info{padding:8rpx 28rpx}.info>view{display:flex;align-items:center;gap:14rpx;padding:24rpx 0;border-bottom:1rpx solid #ede9df}.info>view:last-child{border:0}.info>view>text:first-child{color:#817d72}.info>view>text:nth-child(2){margin-left:auto;text-align:right}.undo{color:#b15d4b}.delete{margin-top:35rpx;background:transparent;color:#b25443;font-size:25rpx}.delete::after{border:0}
