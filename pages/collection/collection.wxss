.intro{padding:28rpx}.intro .title{display:block;font-size:35rpx;font-weight:800;margin-bottom:10rpx}.intro text:last-child{color:#817d72;font-size:23rpx;line-height:1.6}.collection-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.nutrient{text-align:center;padding:28rpx 15rpx}.orb{display:block;font-size:75rpx}.name{display:block;font-size:27rpx;font-weight:700;margin-top:12rpx}.source{display:block;font-size:21rpx;color:#817d72;margin-top:5rpx}.count{display:inline-block;margin-top:13rpx;padding:6rpx 14rpx;border-radius:15rpx;background:#edf1e9;color:#61755d}.locked{filter:grayscale(1);opacity:.48}.safety{text-align:center;color:#9a958b;font-size:20rpx;margin:25rpx}
