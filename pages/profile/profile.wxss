.profile-page{padding-top:calc(28rpx + env(safe-area-inset-top))}.account-card{padding:28rpx;margin-bottom:20rpx;overflow:hidden}.login-visual,.profile-state{display:flex;align-items:center;min-width:0}.avatar-placeholder,.avatar-button,.sheet-avatar{flex:none;display:flex;align-items:center;justify-content:center;border-radius:50%;background:linear-gradient(145deg,#f3e8f0,#e4ecdf);color:#596554;font-weight:900}.avatar-placeholder{width:92rpx;height:92rpx;margin-right:22rpx;font-size:36rpx}.account-title,.account-sub,.profile-name,.sub{display:block}.account-title{font-size:34rpx;font-weight:900}.account-sub{margin-top:7rpx;color:#817d72;font-size:21rpx;line-height:1.45}.wechat-login{height:84rpx;margin-top:26rpx;border-radius:42rpx;background:#30352f;color:#fff;display:flex;align-items:center;justify-content:center;font-size:27rpx;font-weight:700}.wechat-login::after,.avatar-button::after,.edit-entry::after,.sheet-avatar::after,.save-profile::after,.cancel-profile::after{border:0}.wechat-mark{width:38rpx;height:38rpx;margin-right:13rpx;border-radius:50%;background:#24b45a;color:#fff;font-size:19rpx;line-height:38rpx;text-align:center}.privacy-note{display:block;margin-top:14rpx;color:#aaa59b;text-align:center;font-size:18rpx}.avatar-button{position:relative;width:104rpx;height:104rpx;margin:0 22rpx 0 0;padding:0;font-size:38rpx;overflow:visible}.avatar-button image,.sheet-avatar image{width:100%;height:100%;border-radius:50%}.camera{position:absolute;right:-2rpx;bottom:-2rpx;width:32rpx;height:32rpx;border:4rpx solid #fffdf8;border-radius:50%;background:#3c423a;color:white;font-size:22rpx;font-weight:500;line-height:32rpx;text-align:center}.profile-copy{flex:1;min-width:0}.name-line{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx}.profile-name{max-width:260rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:34rpx;font-weight:900}.verified{padding:5rpx 11rpx;border-radius:999rpx;background:#edf3e9;color:#63775f;font-size:17rpx}.edit-entry{flex:none;margin:0 0 0 14rpx;padding:0 16rpx;height:56rpx;line-height:56rpx;border-radius:28rpx;background:#f0ede5;color:#666158;font-size:21rpx}.weekly{padding:28rpx}.weekly-top{display:flex;justify-content:space-between;font-weight:700}.link{font-size:23rpx;color:#61755d}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:26rpx}.stat-grid view{text-align:center;border-right:1rpx solid #e8e4da;min-width:0}.stat-grid view:last-child{border:0}.stat-grid text{display:block;font-size:21rpx;color:#817d72;margin-top:6rpx}.stat-grid .stat-number{font-size:40rpx;font-weight:800;color:#3d4038}.growth{display:flex;align-items:center;justify-content:space-between;padding:25rpx 28rpx;margin-top:18rpx}.menu-title{font-weight:700}.sub{font-size:21rpx;color:#817d72;margin-top:7rpx}.growth-num{color:#8d70a8;font-weight:800}.settings{padding:0 28rpx}.settings>view{min-height:105rpx;display:flex;align-items:center;border-bottom:1rpx solid #ece8df}.settings>view:last-child{border:0}.settings switch,.settings .arrow{margin-left:auto}.arrow{color:#aaa499;font-size:42rpx}.danger .menu-title{color:#ad5949}.footer{display:block;text-align:center;color:#aaa59b;font-size:19rpx;margin:45rpx 0}.sheet-mask{position:fixed;z-index:100;inset:0;background:rgba(34,32,29,.42);display:flex;align-items:flex-end}.profile-sheet{width:100%;padding:18rpx 36rpx calc(34rpx + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:36rpx 36rpx 0 0;background:#fffdf8}.sheet-handle{width:72rpx;height:7rpx;margin:0 auto 26rpx;border-radius:9rpx;background:#ddd8ce}.sheet-title{display:block;font-size:36rpx;font-weight:900;text-align:center}.sheet-sub{display:block;margin-top:8rpx;color:#888278;font-size:20rpx;text-align:center}.sheet-avatar{position:relative;width:126rpx;height:126rpx;margin:28rpx auto;padding:0;font-size:42rpx;overflow:visible}.nickname-field{padding:18rpx 22rpx;border:2rpx solid #ebe7dd;border-radius:22rpx;background:#faf8f2}.field-label{display:block;color:#8a8479;font-size:19rpx}.nickname-field input{height:52rpx;margin-top:5rpx;font-size:28rpx;font-weight:700}.save-profile,.cancel-profile{height:84rpx;border-radius:42rpx;font-size:27rpx}.save-profile{margin-top:24rpx;background:#30352f;color:white;font-weight:700}.cancel-profile{margin-top:8rpx;background:transparent;color:#817d72}
