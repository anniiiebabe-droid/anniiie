.profile-page {
  padding-top: calc(28rpx + env(safe-area-inset-top));
}
.account-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.login-visual,
.profile-state {
  width: 100%;
  min-height: 108rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.avatar-placeholder {
  width: 92rpx;
  height: 92rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #f3e8f0, #e4ecdf);
  color: #596554;
  font-size: 36rpx;
  font-weight: 900;
}
.account-title,
.account-sub,
.profile-name,
.sub {
  display: block;
}
.account-title {
  font-size: 34rpx;
  font-weight: 900;
}
.account-sub {
  max-width: 100%;
  margin-top: 7rpx;
  overflow: hidden;
  color: #817d72;
  font-size: 21rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wechat-login {
  width: 100%;
  height: 84rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 42rpx;
  background: #30352f;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 84rpx;
}
.wechat-mark {
  width: 38rpx;
  height: 38rpx;
  margin-right: 13rpx;
  border-radius: 50%;
  background: #24b45a;
  color: #fff;
  font-size: 19rpx;
  line-height: 38rpx;
  text-align: center;
}
.privacy-note {
  display: block;
  margin-top: 14rpx;
  color: #aaa59b;
  text-align: center;
  font-size: 18rpx;
}
.avatar-slot,
.sheet-avatar-slot {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  min-width: 104rpx;
  max-width: 104rpx;
  flex-shrink: 0;
  border-radius: 52rpx;
  background: linear-gradient(145deg, #f3e8f0, #e4ecdf);
}
.avatar-slot {
  margin-right: 22rpx;
}
.avatar-image,
.avatar-fallback {
  display: block;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
}
.avatar-fallback {
  color: #596554;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 104rpx;
  text-align: center;
}
.avatar-action {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 38rpx;
  min-width: 38rpx;
  max-width: 38rpx;
  height: 38rpx;
  min-height: 38rpx;
  margin: 0;
  padding: 0;
  border: 4rpx solid #fffdf8;
  border-radius: 50%;
  background: #3c423a;
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}
.avatar-action::after,
.wechat-login::after,
.edit-entry::after,
.save-profile::after,
.cancel-profile::after {
  border: 0;
}
.profile-copy {
  width: calc(100% - 220rpx);
  min-width: 0;
  overflow: hidden;
}
.name-line {
  width: 100%;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.profile-name {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 900;
}
.verified {
  margin-left: 10rpx;
  padding: 5rpx 11rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #edf3e9;
  color: #63775f;
  font-size: 17rpx;
  white-space: nowrap;
}
.edit-entry {
  width: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
  height: 56rpx;
  margin: 0 0 0 12rpx;
  padding: 0;
  flex-shrink: 0;
  border-radius: 28rpx;
  background: #f0ede5;
  color: #666158;
  font-size: 21rpx;
  line-height: 56rpx;
  text-align: center;
  box-sizing: border-box;
}
.weekly { padding: 28rpx; }
.weekly-top { display: flex; justify-content: space-between; font-weight: 700; }
.link { font-size: 23rpx; color: #61755d; }
.stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 26rpx; }
.stat-grid view { min-width: 0; text-align: center; border-right: 1rpx solid #e8e4da; }
.stat-grid view:last-child { border: 0; }
.stat-grid text { display: block; margin-top: 6rpx; color: #817d72; font-size: 21rpx; }
.stat-grid .stat-number { color: #3d4038; font-size: 40rpx; font-weight: 800; }
.growth { display: flex; align-items: center; justify-content: space-between; padding: 25rpx 28rpx; margin-top: 18rpx; }
.menu-title { font-weight: 700; }
.sub { margin-top: 7rpx; color: #817d72; font-size: 21rpx; }
.growth-num { color: #8d70a8; font-weight: 800; }
.settings { padding: 0 28rpx; }
.settings > view { min-height: 105rpx; display: flex; align-items: center; border-bottom: 1rpx solid #ece8df; }
.settings > view:last-child { border: 0; }
.settings switch,
.settings .arrow { margin-left: auto; }
.arrow { color: #aaa499; font-size: 42rpx; }
.danger .menu-title { color: #ad5949; }
.footer { display: block; margin: 45rpx 0; color: #aaa59b; text-align: center; font-size: 19rpx; }
.sheet-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(34, 32, 29, .42);
}
.profile-sheet {
  width: 100%;
  padding: 18rpx 36rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fffdf8;
  box-sizing: border-box;
}
.sheet-handle { width: 72rpx; height: 7rpx; margin: 0 auto 26rpx; border-radius: 9rpx; background: #ddd8ce; }
.sheet-title { display: block; text-align: center; font-size: 36rpx; font-weight: 900; }
.sheet-sub { display: block; margin-top: 8rpx; color: #888278; text-align: center; font-size: 20rpx; }
.sheet-avatar-slot {
  width: 126rpx;
  min-width: 126rpx;
  max-width: 126rpx;
  height: 126rpx;
  margin: 28rpx auto;
  border-radius: 63rpx;
}
.sheet-avatar-slot .avatar-image,
.sheet-avatar-slot .avatar-fallback { width: 126rpx; height: 126rpx; border-radius: 63rpx; }
.sheet-avatar-slot .avatar-fallback { line-height: 126rpx; }
.sheet-avatar-action { right: 0; bottom: 0; }
.nickname-field { padding: 18rpx 22rpx; border: 2rpx solid #ebe7dd; border-radius: 22rpx; background: #faf8f2; }
.field-label { display: block; color: #8a8479; font-size: 19rpx; }
.nickname-field input { height: 52rpx; margin-top: 5rpx; font-size: 28rpx; font-weight: 700; }
.save-profile,
.cancel-profile { width: 100%; height: 84rpx; margin-left: 0; margin-right: 0; padding: 0; border-radius: 42rpx; font-size: 27rpx; line-height: 84rpx; }
.save-profile { margin-top: 24rpx; background: #30352f; color: #fff; font-weight: 700; }
.cancel-profile { margin-top: 8rpx; background: transparent; color: #817d72; }
