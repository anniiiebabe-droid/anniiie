.profile-head{display:flex;align-items:center;padding:14rpx 5rpx 30rpx}.avatar{width:92rpx;height:92rpx;border-radius:30rpx;background:#789176;color:#fff;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:900;margin-right:20rpx}.title{display:block;font-size:36rpx;font-weight:900}.sub{display:block;font-size:21rpx;color:#817d72;margin-top:7rpx}.weekly{padding:28rpx}.weekly-top{display:flex;justify-content:space-between;font-weight:700}.link{font-size:23rpx;color:#61755d}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:26rpx}.stat-grid view{text-align:center;border-right:1rpx solid #e8e4da}.stat-grid view:last-child{border:0}.stat-grid b,.stat-grid text{display:block}.stat-grid b{font-size:40rpx}.stat-grid text{font-size:21rpx;color:#817d72;margin-top:6rpx}.growth{display:flex;align-items:center;justify-content:space-between;padding:25rpx 28rpx;margin-top:18rpx}.menu-title{font-weight:700}.growth-num{color:#8d70a8;font-weight:800}.settings{padding:0 28rpx}.settings>view{min-height:105rpx;display:flex;align-items:center;border-bottom:1rpx solid #ece8df}.settings>view:last-child{border:0}.settings switch,.settings .arrow{margin-left:auto}.arrow{color:#aaa499;font-size:42rpx}.danger .menu-title{color:#ad5949}.footer{display:block;text-align:center;color:#aaa59b;font-size:19rpx;margin:45rpx 0}
.avatar-button{position:relative;margin:0 20rpx 0 0;padding:0;width:100rpx;height:100rpx;border-radius:32rpx;background:#789176;color:#fff;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:900;overflow:visible}.avatar-button::after{border:0}.avatar-button image{width:100%;height:100%;border-radius:32rpx}.camera{position:absolute;right:-8rpx;bottom:-8rpx;width:35rpx;height:35rpx;border-radius:50%;background:#f0c969;color:#4d4a42;font-size:19rpx;display:flex;align-items:center;justify-content:center;border:4rpx solid #f7f3e9}.profile-copy{flex:1}.profile-copy input{font-size:36rpx;font-weight:900;height:52rpx}
.stat-grid .stat-number{font-size:40rpx;font-weight:800;color:#3d4038}
