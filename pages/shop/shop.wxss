.balance{padding:30rpx;border-radius:28rpx;background:linear-gradient(135deg,#806b9a,#a687b0);color:#fff}.balance text{display:block;font-size:23rpx;opacity:.8}.balance b{display:block;font-size:45rpx;margin-top:8rpx}.shop-note{margin:18rpx 4rpx 25rpx;color:#817d72;font-size:21rpx}.product{display:flex;align-items:center;padding:20rpx;margin-bottom:16rpx}.product-icon{width:100rpx;height:100rpx;border-radius:25rpx;display:flex;align-items:center;justify-content:center;font-size:55rpx;margin-right:20rpx}.name,.type,.price{display:block}.name{font-size:28rpx;font-weight:700}.type{font-size:20rpx;color:#817d72;margin:5rpx 0}.price{font-size:23rpx;color:#92702c}.buy{margin:0;width:116rpx;padding:0;height:62rpx;line-height:62rpx;border-radius:18rpx;background:#789176;color:#fff;font-size:23rpx}.buy::after{border:0}.buy.owned{background:#e3e3dc;color:#918e85}
.balance .balance-number{display:block;font-size:45rpx;margin-top:8rpx;font-weight:800;opacity:1}
