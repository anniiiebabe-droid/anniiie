<view class="page pet-page">
 <view class="pet-head"><text class="overline">YOUR FOOD BUDDY</text><text class="title">令令的成长屋</text></view>
 <view class="pet-stage card"><view class="speech">{{say}}</view><lingling-character size="large" equipped="{{equipped}}" expression="{{lingling.currentExpression}}" mood="{{mood}}" interactive bindinteract="interact"/><text class="tap-hint">轻轻点一下令令 · 它会回应冰箱状态</text></view>
 <view class="stats card"><view class="level-row"><view><text class="level">Lv.{{lingling.level}}</text><text class="stage">{{lingling.stageName}}</text></view><view class="points">⭐ {{lingling.points}}</view></view><xp-progress value="{{lingling.progress}}" label="{{lingling.isMax?'已经是最佳搭档':lingling.xp+' / '+lingling.nextXp+' XP'}}"/></view>
 <view class="today card"><view><text class="today-title">今日获得的养料</text><text class="today-sub">完成食用食材后，养料会来到这里</text></view><view wx:if="{{todayNutrients.length}}" class="nutrients"><text wx:for="{{todayNutrients}}" wx:key="index">{{item}}</text></view><text wx:else class="none">还没有</text></view>
 <view class="menu-grid"><view class="menu wardrobe" data-url="/pages/wardrobe/wardrobe" bindtap="go"><text class="menu-icon">🎀</text><text>装扮衣柜</text><text class="menu-sub">更换造型</text></view><view class="menu shop" data-url="/pages/shop/shop" bindtap="go"><text class="menu-icon">⭐</text><text>积分商城</text><text class="menu-sub">兑换好物</text></view><view class="menu collection" data-url="/pages/collection/collection" bindtap="go"><text class="menu-icon">🌱</text><text>养料图鉴</text><text class="menu-sub">收集记录</text></view><view class="menu achievement" data-url="/pages/achievements/achievements" bindtap="go"><text class="menu-icon">🏅</text><text>成就徽章</text><text class="menu-sub">一起成长</text></view></view>
</view>
