.pet-head{text-align:center;margin:5rpx 0 22rpx}.overline{display:block;color:#8d70a8;font-size:19rpx;letter-spacing:4rpx;font-weight:700}.title{display:block;font-size:41rpx;font-weight:900;margin-top:7rpx}.pet-stage{position:relative;padding:30rpx 10rpx 12rpx;text-align:center;background:linear-gradient(#f3e8f2,#fffdf8);overflow:hidden}.speech{display:inline-block;max-width:540rpx;padding:14rpx 22rpx;background:white;border-radius:22rpx;color:#686258;font-size:22rpx;box-shadow:0 6rpx 15rpx rgba(78,68,76,.06)}.tap-hint{display:block;color:#9b958c;font-size:20rpx;margin-top:-20rpx}.stats{padding:26rpx;margin-top:20rpx}.level-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:19rpx}.level{font-size:34rpx;font-weight:900;margin-right:14rpx}.stage{color:#817d72;font-size:23rpx}.points{padding:12rpx 19rpx;border-radius:18rpx;background:#f5ebc9;color:#83631f;font-weight:700}.today{padding:24rpx;margin-top:20rpx;display:flex;align-items:center}.today-title,.today-sub{display:block}.today-title{font-weight:700}.today-sub{font-size:20rpx;color:#817d72;margin-top:6rpx}.nutrients,.none{margin-left:auto}.nutrients text{font-size:37rpx}.none{color:#aaa59b;font-size:22rpx}.menu-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:20rpx}.menu{height:155rpx;border-radius:28rpx;padding:22rpx;box-sizing:border-box;background:#fffdf8;display:flex;flex-direction:column;box-shadow:0 8rpx 24rpx rgba(75,70,60,.05);font-weight:700}.menu-icon{font-size:40rpx;margin-bottom:8rpx}.menu small{display:block;font-size:20rpx;color:#817d72;margin-top:4rpx;font-weight:400}.wardrobe{background:#f3e7ef}.shop{background:#f7edcf}.collection{background:#e7efe3}.achievement{background:#f6e4dc}
.menu-sub{display:block;font-size:20rpx;color:#817d72;margin-top:4rpx;font-weight:400}
