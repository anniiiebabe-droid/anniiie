.device-page{padding-top:45rpx}.device{position:relative;padding:26rpx;border-radius:38rpx;background:#262724;box-shadow:0 18rpx 45rpx rgba(30,30,27,.25)}.screen{min-height:760rpx;padding:35rpx;box-sizing:border-box;border-radius:17rpx;background:#e9e8df;color:#1d1e1b;filter:grayscale(1);font-family:monospace;box-shadow:inset 0 0 18rpx rgba(0,0,0,.18)}.screen-top{display:flex;justify-content:space-between}.brand{display:block;font-size:18rpx;letter-spacing:2rpx}.date{display:block;font-size:36rpx;font-weight:900;margin-top:8rpx}.battery{font-size:18rpx}.divider{border-top:4rpx solid #1d1e1b;margin:25rpx 0}.screen-title{display:block;font-size:26rpx;font-weight:700;margin-bottom:20rpx}.screen-list>view{display:flex;align-items:center;padding:25rpx 0;border-bottom:2rpx solid #777}.num{font-size:20rpx;margin-right:22rpx}.food,.meta{display:block}.food{font-size:38rpx;font-weight:900}.meta{font-size:19rpx;margin-top:6rpx}.screen-empty{text-align:center;padding:130rpx 0;line-height:2;font-size:26rpx}.screen-bottom{display:flex;justify-content:space-between;margin-top:45rpx;font-size:22rpx;font-weight:700}.magnet{position:absolute;width:18rpx;height:18rpx;border-radius:50%;background:#777;top:14rpx}.m1{left:50rpx}.m2{right:50rpx}.sync-time{display:block;text-align:center;color:#817d72;font-size:20rpx;margin:25rpx}.sync{width:100%;background:#333530;color:white}.tip{margin-top:22rpx;padding:20rpx;border-radius:18rpx;background:#e9e4d7;color:#777166;font-size:21rpx;line-height:1.5}
.screen-empty text{display:block}
