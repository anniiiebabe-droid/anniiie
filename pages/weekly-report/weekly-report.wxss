.report-head{text-align:center;padding:10rpx 0 30rpx}.overline{display:block;color:#789176;font-size:18rpx;letter-spacing:4rpx;font-weight:700}.title{display:block;font-size:43rpx;font-weight:900;margin:8rpx}.range{color:#817d72;font-size:22rpx}.hero-stat{padding:30rpx;display:flex;align-items:center}.ring{width:150rpx;height:150rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-right:28rpx}.ring view{width:110rpx;height:110rpx;border-radius:50%;background:#fffdf8;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:31rpx}.hero-title{display:block;font-size:30rpx;font-weight:800}.hero-sub{display:block;color:#817d72;font-size:21rpx;margin-top:8rpx}.bars{padding:28rpx}.bars>view+view{margin-top:26rpx}.bar-label{display:flex;justify-content:space-between;font-size:23rpx;margin-bottom:10rpx}.track{height:20rpx;border-radius:20rpx;background:#e8e5dc;overflow:hidden}.fill{height:100%;border-radius:20rpx}.sage{background:#789176}.orange{background:#e98558}.rewards{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.reward{text-align:center;padding:24rpx 8rpx}.reward text{display:block;font-size:40rpx}.reward b{display:block;font-size:31rpx;margin:9rpx}.reward small{font-size:19rpx;color:#817d72}.empty-report{text-align:center;padding:70rpx 35rpx;color:#817d72}.empty-title{display:block;color:#3d4038;font-size:31rpx;font-weight:800;margin:18rpx}.quote{text-align:center;color:#8d70a8;font-size:22rpx;margin:35rpx 0}
.reward .reward-number{display:block;font-size:31rpx;margin:9rpx;font-weight:800}.reward .reward-label{font-size:19rpx;color:#817d72}.bar-number{font-weight:800}
