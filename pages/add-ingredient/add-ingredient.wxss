.form-intro{padding:12rpx 8rpx 28rpx;color:#817d72;font-size:23rpx}.intro-title{display:block;color:#3d4038;font-size:39rpx;font-weight:800;margin-bottom:10rpx}.form-card{padding:10rpx 28rpx}.field{padding:24rpx 0;border-bottom:1rpx solid #ece8de}.field:last-child{border:0}.label{display:block;font-size:24rpx;font-weight:600;margin-bottom:14rpx}.required{color:#d06f57}input,.picker,textarea{font-size:28rpx;min-height:45rpx}textarea{width:100%;height:120rpx;line-height:1.5}.picker{display:flex;justify-content:space-between}.placeholder{color:#aaa59a}.two-col{display:flex;gap:30rpx}.unit{width:180rpx}.save{margin-top:28rpx;width:100%}
