.form-intro{padding:12rpx 8rpx 24rpx;color:#817d72;font-size:23rpx;line-height:1.55}.intro-title{display:block;color:#3d4038;font-size:39rpx;font-weight:800;margin-bottom:10rpx}.scan-button{width:100%;height:118rpx;margin:0 0 22rpx;padding:0 24rpx;display:flex;align-items:center;text-align:left;border-radius:27rpx;background:linear-gradient(135deg,#7b9277,#91a98b);color:#fff}.scan-button::after{border:0}.scan-icon{width:68rpx;height:68rpx;border-radius:21rpx;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:44rpx;margin-right:18rpx}.scan-title,.scan-sub{display:block}.scan-title{font-size:29rpx;font-weight:800}.scan-sub{font-size:20rpx;opacity:.76;margin-top:5rpx}.scan-arrow{margin-left:auto;font-size:43rpx}.recognizing{position:fixed;z-index:20;inset:0;background:rgba(247,243,233,.94);display:flex;align-items:center;justify-content:center;flex-direction:column;color:#526950}.scan-line{width:250rpx;height:8rpx;margin-bottom:30rpx;border-radius:8rpx;background:#789176;box-shadow:0 0 22rpx #789176;animation:scan 1s ease-in-out infinite alternate}@keyframes scan{from{transform:translateY(-50rpx)}to{transform:translateY(50rpx)}}.form-card{padding:10rpx 28rpx}.field{padding:24rpx 0;border-bottom:1rpx solid #ece8de}.field:last-child{border:0}.label{display:block;font-size:24rpx;font-weight:600;margin-bottom:14rpx}.required{color:#d06f57}input,.picker,textarea{font-size:28rpx;min-height:45rpx}textarea{width:100%;height:110rpx;line-height:1.5}.picker{display:flex;justify-content:space-between}.two-col{display:flex;gap:30rpx}.unit{width:180rpx}.auto-tag{display:inline-block;margin-top:12rpx;padding:6rpx 12rpx;border-radius:12rpx;background:#e3eddf;color:#60785d;font-size:19rpx}.auto-value{font-size:28rpx}.auto-value text{font-size:18rpx;color:#789176;margin-left:8rpx}.estimate{margin:20rpx 0 4rpx;padding:25rpx;border-radius:22rpx;background:linear-gradient(135deg,#edf2e9,#f7edda);display:flex;align-items:center;flex-wrap:wrap}.estimate-label,.estimate-date{display:block}.estimate-label{font-size:21rpx;color:#6f756a}.estimate-date{font-size:34rpx;font-weight:900;margin-top:6rpx}.days{margin-left:auto;color:#765d35;font-size:22rpx}.days-number{font-size:32rpx;font-weight:800}.estimate-source{width:100%;font-size:19rpx;color:#8b867c;margin-top:15rpx}.safety-note{padding:18rpx 20rpx;color:#8a735d;font-size:20rpx;line-height:1.5}.save{margin-top:12rpx;width:100%}
