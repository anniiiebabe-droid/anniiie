<view class="page form-page">
  <view class="form-intro"><text class="intro-title">{{isEdit?'更新食材信息':'把食材放进冰箱'}}</text><text>令令会自动识别分类，并根据购买日期和储存位置估算建议食用日期。</text></view>
  <button wx:if="{{!isEdit}}" class="scan-button" bindtap="recognize"><text class="scan-icon">⌾</text><view><text class="scan-title">拍照智能识别</text><text class="scan-sub">拍一下食材，自动填写名称与分类</text></view><text class="scan-arrow">›</text></button>
  <view wx:if="{{recognizing}}" class="recognizing"><view class="scan-line"></view><text>令令正在识别食材…</text></view>
  <view class="form-card card">
    <view class="field"><text class="label">食材名称 <text class="required">*</text></text><input value="{{form.name}}" placeholder="例如：苹果" data-key="name" bindinput="input" maxlength="20" /><text wx:if="{{autoMatched}}" class="auto-tag">✓ 已匹配食材知识库</text></view>
    <view class="two-col"><view class="field grow"><text class="label">数量 <text class="required">*</text></text><input type="digit" value="{{form.quantity}}" placeholder="0" data-key="quantity" bindinput="input" /></view><view class="field unit"><text class="label">单位 <text class="required">*</text></text><picker range="{{units}}" bindchange="pick" data-key="unit"><view class="picker">{{form.unit}} ›</view></picker></view></view>
    <view class="field"><text class="label">购买日期 <text class="required">*</text></text><picker mode="date" value="{{form.purchaseDate}}" end="{{today}}" bindchange="date" data-key="purchaseDate"><view class="picker">{{form.purchaseDate||today}} ›</view></picker></view>
    <view class="two-col"><view class="field grow"><text class="label">自动分类</text><view wx:if="{{hasEstimate}}" class="auto-value">{{form.category}} <text>智能识别</text></view><view wx:else class="auto-pending">填写名称后识别</view></view><view class="field grow"><text class="label">储存位置</text><picker range="{{locations}}" bindchange="pick" data-key="storageLocation"><view class="picker">{{form.storageLocation}} ›</view></picker></view></view>
    <view wx:if="{{hasEstimate}}" class="estimate"><view><text class="estimate-label">建议食用日期</text><text class="estimate-date">{{form.priorityUseDate}}</text></view><view class="days">约可保存 <text class="days-number">{{form.shelfLifeDays}}</text> 天</view><text class="estimate-source">依据：{{form.estimateSource}} · {{form.storageLocation}}</text></view>
    <view wx:else class="estimate-empty"><text class="estimate-empty-icon">✦</text><view><text class="estimate-empty-title">等待识别食材</text><text class="estimate-empty-sub">填写食材名称或拍照后，自动生成建议食用日期</text></view></view>
    <view class="field"><text class="label">储存备注</text><textarea value="{{form.note}}" placeholder="例如：已切开，用保鲜盒密封" data-key="note" bindinput="input" maxlength="100" /></view>
  </view>
  <view class="safety-note">日期为常规储存条件下的参考估算；如有异味、霉变或包装异常，请勿食用。</view>
  <button class="btn btn-primary save" bindtap="save">{{isEdit?'保存修改':'确认放入冰箱'}}</button>
</view>
