<view class="page recipe-page">
 <view wx:if="{{selected}}"><view class="recipe-hero"><text class="back" bindtap="back">‹ 返回食谱库</text><text class="hero-emoji">{{selected.emoji}}</text><text class="hero-name">{{selected.name}}</text><text class="hero-desc">{{selected.desc}}</text><view class="meta"><text>⏱ {{selected.minutes}} 分钟</text><text>✦ {{selected.difficulty}}</text><text>冰箱匹配 {{selected.matchText}}</text></view></view><view class="detail-card card"><text class="detail-title">需要食材</text><view class="ingredient-tags"><text wx:for="{{selected.ingredientsView}}" wx:key="name" class="{{item.available?'ready':'missing'}}">{{item.name}} {{item.available?'✓':'需补充'}}</text></view></view><view class="detail-card card"><text class="detail-title">烹饪步骤</text><view wx:for="{{selected.steps}}" wx:key="index" class="step"><text class="step-num">{{index+1}}</text><text>{{item}}</text></view></view><view class="tip">优先食用临近建议食用日期的食材；烹饪前请自行检查食材状态。</view></view>
 <view wx:else><view class="search-head"><text class="title">今天想吃什么？</text><text class="subtitle">根据冰箱库存找灵感，也可以搜索菜名或食材</text><view class="search"><text>⌕</text><input placeholder="搜索番茄、鸡蛋或菜名" value="{{query}}" bindinput="input"/></view></view><view wx:for="{{recipes}}" wx:key="id" class="recipe-item card" data-id="{{item.id}}" bindtap="select"><view class="food-art">{{item.emoji}}</view><view class="grow"><text class="name">{{item.name}}</text><text class="desc">{{item.desc}}</text><view class="item-meta"><text>{{item.minutes}} 分钟</text><text>库存 {{item.matchText}}</text></view></view><text class="arrow">›</text></view><view wx:if="{{!recipes.length}}" class="empty card">暂时没有找到，换个食材试试</view></view>
</view>
