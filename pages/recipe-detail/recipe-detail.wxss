.recipe-page{padding-bottom:50rpx}.search-head{padding:10rpx 3rpx 25rpx}.title{display:block;font-size:42rpx;font-weight:900}.subtitle{display:block;color:#817d72;font-size:22rpx;margin:9rpx 0 22rpx}.search{height:82rpx;padding:0 22rpx;border-radius:23rpx;background:#fffdf8;display:flex;align-items:center;box-shadow:0 7rpx 22rpx rgba(75,70,60,.05)}.search text{font-size:35rpx;color:#789176;margin-right:15rpx}.search input{flex:1;font-size:26rpx}.recipe-item{display:flex;align-items:center;padding:20rpx;margin-bottom:17rpx}.food-art{width:115rpx;height:115rpx;border-radius:28rpx;background:linear-gradient(135deg,#f6e7ce,#ecf0e6);display:flex;align-items:center;justify-content:center;font-size:63rpx;margin-right:20rpx}.name,.desc{display:block}.name{font-size:29rpx;font-weight:800}.desc{font-size:20rpx;color:#817d72;line-height:1.45;margin-top:5rpx}.item-meta{display:flex;gap:14rpx;margin-top:10rpx}.item-meta text{font-size:18rpx;padding:5rpx 10rpx;border-radius:10rpx;background:#edf1e9;color:#62755e}.arrow{font-size:45rpx;color:#aaa499}.recipe-hero{text-align:center;margin:-28rpx -28rpx 25rpx;padding:28rpx 28rpx 45rpx;background:linear-gradient(160deg,#dfe9dc,#faecd6);border-radius:0 0 42rpx 42rpx}.back{display:block;text-align:left;color:#60765d;font-size:22rpx}.hero-emoji{display:block;font-size:115rpx;margin:20rpx}.hero-name{display:block;font-size:44rpx;font-weight:900}.hero-desc{display:block;color:#6e6a61;font-size:23rpx;line-height:1.6;margin:12rpx auto;max-width:570rpx}.meta{display:flex;justify-content:center;gap:12rpx;margin-top:18rpx}.meta text{padding:8rpx 13rpx;border-radius:14rpx;background:rgba(255,255,255,.6);font-size:19rpx}.detail-card{padding:28rpx;margin-bottom:18rpx}.detail-title{display:block;font-size:31rpx;font-weight:900;margin-bottom:20rpx}.ingredient-tags{display:flex;flex-wrap:wrap;gap:12rpx}.ingredient-tags text{padding:11rpx 16rpx;border-radius:15rpx;font-size:22rpx}.ready{background:#e3eddf;color:#5c7358}.missing{background:#f5e4d4;color:#9a684c}.step{display:flex;align-items:flex-start;line-height:1.6;margin:20rpx 0;color:#56564f}.step-num{flex:none;width:43rpx;height:43rpx;border-radius:50%;background:#789176;color:#fff;display:flex;align-items:center;justify-content:center;margin-right:17rpx;font-weight:800}.tip{padding:20rpx;color:#817d72;font-size:20rpx;text-align:center}
