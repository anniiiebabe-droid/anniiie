<view class="page"><view class="preview card"><text class="caption">今日穿搭</text><lingling-character size="medium" equipped="{{equipped}}" expression="{{expression}}"/></view><view class="section-head"><text class="section-title">已拥有 {{items.length}} 件</text><text class="section-link" bindtap="shop">去商城 ›</text></view><view class="outfit-grid"><view wx:for="{{items}}" wx:key="id" class="outfit {{item.equipped?'selected':''}}" data-id="{{item.id}}" bindtap="equip"><view class="outfit-icon" style="background:{{item.color}}22">{{item.icon}}</view><text class="outfit-name">{{item.name}}</text><text class="state">{{item.equipped?'穿戴中':'点击穿戴'}}</text></view></view></view>
