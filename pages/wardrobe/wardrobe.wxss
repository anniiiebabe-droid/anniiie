.preview{text-align:center;padding:25rpx 10rpx 5rpx;background:linear-gradient(#e7efe3,#fffdf8)}.caption{display:block;font-weight:700;color:#657461}.outfit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15rpx}.outfit{padding:14rpx 10rpx 18rpx;text-align:center;background:#fffdf8;border:4rpx solid transparent;border-radius:24rpx}.outfit.selected{border-color:#879b80}.outfit-icon{height:115rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;font-size:60rpx}.outfit-name{display:block;font-weight:700;font-size:23rpx;margin-top:12rpx}.state{font-size:19rpx;color:#8b867d}.selected .state{color:#637860}
