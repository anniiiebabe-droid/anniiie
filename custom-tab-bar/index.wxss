.tabbar{position:fixed;z-index:50;left:0;right:0;bottom:0;height:118rpx;padding-bottom:env(safe-area-inset-bottom);display:flex;background:rgba(255,253,248,.98);box-shadow:0 -8rpx 30rpx rgba(74,68,55,.08);border-radius:30rpx 30rpx 0 0}.tab{position:relative;flex:1;min-width:0;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#8d897e}.icon{font-size:33rpx;line-height:1}.label{font-size:27rpx;line-height:1.1;font-weight:600;margin-top:8rpx;white-space:nowrap}.active{color:#526b51}.active .icon{transform:translateY(-2rpx);font-weight:900}.dot{position:absolute;bottom:7rpx;width:22rpx;height:5rpx;border-radius:5rpx;background:#789176}
