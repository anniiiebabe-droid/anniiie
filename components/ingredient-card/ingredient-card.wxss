.ingredient-card{display:flex;align-items:center;padding:25rpx;background:#fffdf8;border-radius:25rpx;margin-bottom:18rpx;box-shadow:0 8rpx 24rpx rgba(75,70,60,.06)}.food-icon{width:82rpx;height:82rpx;border-radius:24rpx;background:#ebe5d4;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:34rpx;color:#625d50;margin-right:20rpx}.蔬菜{background:#dce9d6}.水果{background:#f7dfc6}.肉类{background:#f5d8d2}.蛋奶{background:#f7edc9}.豆制品{background:#e7dfc9}.info{flex:1;min-width:0}.name-row{display:flex;align-items:center;gap:12rpx}.name{font-size:31rpx;font-weight:700}.sub,.status{display:block;font-size:23rpx;color:#817d72;margin-top:6rpx}.status{font-size:21rpx}.tag{font-size:19rpx;padding:6rpx 11rpx;border-radius:12rpx;background:#e5ecdf;color:#5e7459}.tag.urgent{background:#f9d8cf;color:#ac5847}.tag.soon{background:#fae6bd;color:#98712e}.tag.check{background:#e9e7e3;color:#77716a}.use{margin:0 0 0 12rpx;padding:0;width:92rpx;height:60rpx;line-height:60rpx;border-radius:18rpx;background:#dfe9dc;color:#526950;font-size:23rpx}.use::after{border:0}
