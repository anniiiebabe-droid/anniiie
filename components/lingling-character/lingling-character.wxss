.character{position:relative;width:330rpx;height:300rpx;margin:0 auto;display:flex;align-items:flex-end;justify-content:center;overflow:visible}
.character.small{width:230rpx;height:205rpx}
.character.large{width:420rpx;height:380rpx}
.model-wrap{position:relative;z-index:2;width:100%;height:100%;display:flex;align-items:flex-end;justify-content:center;transform-origin:50% 92%;animation:breathe 3.2s ease-in-out infinite}
.base-model{display:block;width:100%;height:100%}
.mascot-shadow{position:absolute;z-index:1;left:15%;right:12%;bottom:1%;height:8%;border-radius:50%;background:rgba(62,55,48,.13);filter:blur(7rpx)}
.hat{position:absolute;z-index:4;left:50%;transform:translateX(-50%)}
.onion{top:4%;width:42%;height:25%;background:linear-gradient(90deg,#c98bc7 0%,#dda6d5 28%,#b976b8 55%,#d59aca 78%,#ae6cad 100%);border:5rpx solid #302d29;border-radius:50% 50% 35% 35% / 70% 70% 42% 42%;box-shadow:inset 0 -8rpx 0 rgba(105,57,109,.12)}
.sprout{position:absolute;z-index:4;top:-31%;left:55%;width:23%;height:25%;border:5rpx solid #302d29;border-radius:70% 45% 65% 30%;background:#dce69c;transform:rotate(-35deg)}
.onion-line{position:absolute;top:8%;width:3rpx;height:72%;border-radius:50%;background:#865183;opacity:.72;transform-origin:bottom center}
.line-left{left:32%;transform:rotate(18deg)}.line-right{right:31%;transform:rotate(-18deg)}
.tomato{top:6%;width:40%;height:23%;border-radius:50%;border:5rpx solid #4b463f;background:#e26550}
.tomato .leaf{position:absolute;top:-42%;left:31%;color:#597657;font-size:60rpx}
.emoji-hat{top:-4%;font-size:105rpx;line-height:1}
.scarf{position:absolute;z-index:5;left:22%;right:20%;bottom:12%;height:35rpx;border:4rpx solid #302d29;border-radius:20rpx;background:#dc7f67;color:#f4b59f;text-align:center;font-size:28rpx;line-height:31rpx}
.mood-mark{position:absolute;z-index:6;top:22%;right:7%;width:42rpx;height:42rpx;border-radius:50%;background:#f1c65f;color:#4b4438;font-weight:900;text-align:center;line-height:42rpx;animation:float-mark 1.8s ease-in-out infinite}
.mood-mark.rain{width:auto;padding:0 12rpx;background:#dfe5e3;color:#64706c;letter-spacing:3rpx}
.spark{display:none;position:absolute;z-index:6;color:#dcae44;font-size:28rpx;animation:float-mark 1.5s ease-in-out infinite}
.spark-left{left:4%;top:32%}.spark-right{right:2%;top:42%;animation-delay:.35s}
.garden{border-radius:48%;background:radial-gradient(circle at 17% 77%,#f3d779 0 7rpx,transparent 8rpx),radial-gradient(circle at 82% 74%,#efb1ad 0 7rpx,transparent 8rpx),#dfeadb}
.garden .spark,.mood-happy .spark{display:block}
.mood-happy .model-wrap{animation:cheer 1.25s ease-in-out infinite}
.mood-worried .model-wrap{animation:breathe 2.2s ease-in-out infinite}
.mood-sad .model-wrap{animation:sad-breathe 3.8s ease-in-out infinite;filter:saturate(.78)}
@keyframes breathe{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-4rpx) scale(1.018,.982)}}
@keyframes cheer{0%,100%{transform:translateY(0) rotate(0)}38%{transform:translateY(-16rpx) rotate(-2deg)}70%{transform:translateY(-5rpx) rotate(2deg)}}
@keyframes sad-breathe{0%,100%{transform:translateY(4rpx) scale(.99)}50%{transform:translateY(0) scale(1)}}
@keyframes float-mark{0%,100%{transform:translateY(0)}50%{transform:translateY(-7rpx)}}
