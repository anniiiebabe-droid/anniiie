.mask{position:fixed;z-index:99;inset:0;background:rgba(47,45,40,.45);display:flex;align-items:center;justify-content:center}.popup{position:relative;width:570rpx;padding:50rpx 40rpx 38rpx;box-sizing:border-box;border-radius:38rpx;background:#fffdf8;text-align:center;animation:pop .25s ease-out}.burst{position:absolute;right:45rpx;top:30rpx;color:#eac35f;font-size:50rpx}.title{display:block;font-size:35rpx;font-weight:800}.nutrient{display:block;font-size:100rpx;margin:25rpx}.desc{color:#777267}.chips{display:flex;justify-content:center;gap:18rpx;margin:25rpx}.chips text{padding:12rpx 20rpx;border-radius:18rpx;background:#f2ead6;color:#755d33}.ok{margin-top:20rpx;background:#789176;color:white;border-radius:22rpx;font-size:27rpx}.ok::after{border:0}@keyframes pop{from{transform:scale(.8);opacity:0}to{transform:scale(1);opacity:1}}
