<view wx:if="{{visible}}" class="mask" bindtap="close"><view class="popup" catchtap=""><text class="burst">✦</text><text class="title">令令收到新养料！</text><text class="nutrient">{{reward.nutrient ? reward.nutrient.emoji : '🌱'}}</text><text wx:if="{{reward.nutrient}}" class="desc">{{reward.nutrient.name}} 已收入图鉴</text><view class="chips"><text>+{{reward.transaction.xp}} XP</text><text>+{{reward.transaction.points}} ⭐</text></view><button class="ok" bindtap="close">太好啦</button></view></view>
