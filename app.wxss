page {
  --cream: #f7f3e9;
  --paper: #fffdf8;
  --sage: #789176;
  --sage-dark: #526950;
  --sage-light: #dfe9dc;
  --purple: #8d70a8;
  --orange: #e98558;
  --yellow: #f2c969;
  --ink: #3d4038;
  --muted: #817d72;
  background: var(--cream);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}
.page { min-height: 100vh; padding: 28rpx 28rpx 150rpx; box-sizing: border-box; }
.card { background: var(--paper); border-radius: 28rpx; box-shadow: 0 10rpx 28rpx rgba(76, 72, 60, .07); }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 36rpx 4rpx 20rpx; }
.section-title { font-size: 34rpx; font-weight: 700; }
.section-link { color: var(--sage-dark); font-size: 25rpx; }
.btn { display: flex; align-items: center; justify-content: center; height: 84rpx; border-radius: 24rpx; font-size: 28rpx; font-weight: 600; padding: 0 28rpx; box-sizing: border-box; }
.btn::after { border: 0; }
.btn-primary { color: white; background: var(--sage); }
.btn-soft { color: var(--sage-dark); background: var(--sage-light); }
.btn-warm { color: #6e492e; background: #fae4ca; }
.btn-danger { color: #b25443; background: #f9e2de; }
.pill { display: inline-flex; padding: 9rpx 18rpx; border-radius: 999rpx; font-size: 22rpx; background: #edf1e9; color: var(--sage-dark); }
.muted { color: var(--muted); }
.empty { text-align: center; padding: 70rpx 30rpx; color: var(--muted); }
.empty-icon { display: block; font-size: 70rpx; margin-bottom: 16rpx; }
.row { display: flex; align-items: center; }
.grow { flex: 1; min-width: 0; }
.truncate { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
